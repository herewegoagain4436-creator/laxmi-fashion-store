# Copy to .env for local cloud-style runs (never commit .env)
PORT=8787
HOST=0.0.0.0
LAXMI_DATA_DIR=./apps/server/data
LAXMI_SECRET=change-me-long-random
LAXMI_SYNC_TOKEN=change-me-store-sync-token
# Optional: disable localhost bypass when testing token enforcement
# LAXMI_ALLOW_LOCALHOST_NO_TOKEN=0
# Optional CORS allowlist (comma-separated). Empty = reflect any origin.
# LAXMI_CORS_ORIGIN=https://your-app.example.com
